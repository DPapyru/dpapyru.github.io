---
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/700.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = '星辰小天使', description = '可能是笨猫在写日记' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="星辰小天使" href="/rss.xml" />
  </head>
  <body>
    <header class="site">
      <a class="brand" href="/">星辰小天使</a>
      <nav>
        <a href="/">文章</a>
        <a href="/rss.xml">RSS</a>
        <a href="/about/">关于</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site">2026 · DPapyru · MIT</footer>
  </body>
</html>
