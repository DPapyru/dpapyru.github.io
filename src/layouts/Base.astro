---
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import '@fontsource/jetbrains-mono/800.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}

const { title = '星辰小天使', description = '可能是笨猫在写日记', wide = false } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' || path.startsWith('/posts/') : path.startsWith(href);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/icon-64.png" type="image/png" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <link rel="alternate" type="application/rss+xml" title="星辰小天使" href="/rss.xml" />
  </head>
  <body>
    <header class:list={['site', { wide }]}>
      <a class="brand" href="/">
        <img class="avatar" src="/avatar.jpg" alt="" width="28" height="28" />
        <span>星辰小天使</span>
      </a>
      <nav>
        <a href="/" aria-current={isActive('/') ? 'page' : undefined}>文章</a>
        <a href="/tutorials/" aria-current={isActive('/tutorials/') ? 'page' : undefined}>教程</a>
        <a href="/about/" aria-current={isActive('/about/') ? 'page' : undefined}>关于</a>
        <a href="/rss.xml">RSS</a>
      </nav>
    </header>
    <main class:list={[{ wide }]}>
      <slot />
    </main>
    <footer class="site">
      <span>© 2026 DPapyru · MIT</span>
      <span class="footer-links"><a href="/rss.xml">RSS</a><a href="https://github.com/DPapyru">GitHub</a></span>
    </footer>
    <script is:inline>
      document.querySelectorAll('pre.astro-code').forEach((pre) => {
        const code = pre.querySelector('code');
        if (!code) return;
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'copy';
        button.textContent = '复制';
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(code.innerText);
            button.textContent = '已复制';
          } catch {
            button.textContent = '复制失败';
          }
          setTimeout(() => {
            button.textContent = '复制';
          }, 1500);
        });
        pre.append(button);
      });
    </script>
  </body>
</html>
