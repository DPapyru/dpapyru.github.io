{
  "name": "dpapyru.github.io",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DPapyru 的个人主页 - 托管于 GitHub Pages 的 React 单页应用",
  "scripts": {
    "dev": "vite",
    "build": "bun run build:content && bun run build:seo && tsc --noEmit && vite build",
    "build:content": "bun scripts/build-content.ts",
    "build:seo": "bun scripts/build-seo.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^24.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
